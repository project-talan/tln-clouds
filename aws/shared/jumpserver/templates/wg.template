sudo apt update && sudo apt install -y wireguard iptables


# Налаштування конфігу сервера
cat <<EOT > /etc/wireguard/wg0.conf
[Interface]
PrivateKey = ${server_private_key}
Address = 11.0.0.1/24
ListenPort = 51820
PostUp = iptables -A FORWARD -i wg0 -j ACCEPT; iptables -t nat -A POSTROUTING -o ens5 -j MASQUERADE
PostDown = iptables -D FORWARD -i wg0 -j ACCEPT; iptables -t nat -D POSTROUTING -o ens5 -j MASQUERADE

[Peer]
PublicKey = ${client_public_key}
AllowedIPs = 11.0.0.2/32
EOT

sudo iptables -A FORWARD -i wg0 -o ens5 -j ACCEPT
sudo iptables -A FORWARD -i ens5 -o wg0 -m state --state RELATED,ESTABLISHED -j ACCEPT

sysctl -w net.ipv4.ip_forward=1
systemctl enable wg-quick@wg0
systemctl start wg-quick@wg0